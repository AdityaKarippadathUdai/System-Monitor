{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "SysMon Pro",
  "version": "1.3.0",
  "identifier": "com.sysmon.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "SysMon Pro - Cross-Platform Hardware Monitor",
        "width": 1320,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "center": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "tooltip": "SysMon Pro System Monitor"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "SysMon Pro",
    "copyright": "Copyright (c) 2026 SysMon Pro Contributors",
    "category": "System",
    "shortDescription": "Cross-platform hardware telemetry and process monitor",
    "longDescription": "SysMon Pro is a native cross-platform desktop hardware monitor for Windows 10/11 and Linux providing real-time CPU, RAM, multi-GPU, disk, network, and process telemetry.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "allowDowngrades": true,
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installMode": "both",
        "compression": "lzma",
        "displayLanguageSelector": false,
        "startMenuFolder": "SysMon Pro"
      },
      "wix": {
        "language": "en-US"
      }
    }
  }
}
